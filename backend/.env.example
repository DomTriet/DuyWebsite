# Server Config
PORT=5000
NODE_ENV=development

# CORS: whitelist your frontend domain in production
# Development: * (allow all)
# Production: https://bdsdiemtam.com
CORS_ORIGIN=*

# Supabase Config (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Cloudinary Config (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend Config (for transactional email)
RESEND_API_KEY=re_your_resend_api_key

# MyMemory Translation API (optional, improves translation quality)
MYMEMORY_EMAIL=your_email@example.com
